# Copy this file to .env for local development (`.env` is gitignored — never commit it).
# In production, set this in the Netlify site dashboard instead:
# Site settings → Environment variables.

# Required. Get one at https://console.anthropic.com/settings/keys
# Before going live, also set a hard spending limit at
# https://console.anthropic.com/settings/limits — this is a backstop
# independent of the app's own rate limiting and token caps.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5-20251001 (the cheapest current
# model) if unset, since this endpoint is public. Set to claude-sonnet-5 for
# higher-quality generations at higher per-call cost.
ANTHROPIC_MODEL=
